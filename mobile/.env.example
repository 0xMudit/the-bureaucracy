# Base URL of The Bureaucracy API (the Next.js app). No trailing slash.
#
# Production
#   EXPO_PUBLIC_API_URL=https://the-bureaucracy.vercel.app
#
# Local development
#   iOS simulator / Expo web  -> http://localhost:3000
#   Android emulator          -> http://10.0.2.2:3000  (the app rewrites localhost automatically)
#   Real phone on your LAN    -> http://<your-lan-ip>:3000
#
# Anything prefixed EXPO_PUBLIC_ is inlined into the JavaScript bundle. Never
# put a service-role key or a secret here.
EXPO_PUBLIC_API_URL=http://localhost:3000
