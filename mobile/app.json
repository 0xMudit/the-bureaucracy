{
  "expo": {
    "name": "The Bureaucracy",
    "slug": "the-bureaucracy",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "bureaucracy",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F8F7F3",
    "primaryColor": "#A9271F",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.thebureaucracy.mobile",
      "infoPlist": {}
    },
    "android": {
      "package": "app.thebureaucracy.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8F7F3"
      },
      "permissions": []
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#A9271F",
          "defaultChannel": "brief"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F8F7F3",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#171410"
          }
        }
      ]
    ]
  }
}

