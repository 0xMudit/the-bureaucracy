# Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key. Safe in the browser; enforces row-level security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: newer publishable key. Used when the anon key is absent.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key. Never expose this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: comma-separated emails that always resolve to the admin role.
# The deployment editor's address is included automatically. These addresses
# cannot be demoted or suspended from /admin/users; remove one here first.
ADMIN_EMAILS=

# Shared secret for POST /api/ingest (GitHub Actions or manual curl).
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# Canonical site URL used by metadata, sitemap and the RSS feed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Management API token for `npm run auth:email`, which pushes the
# branded confirmation template and requires email confirmation before login.
# Create one at https://supabase.com/dashboard/account/tokens — never expose it
# with NEXT_PUBLIC_.
SUPABASE_ACCESS_TOKEN=

# Optional: custom SMTP for verification mail (Resend, Postmark, SES, ...).
# Supabase's built-in sender is heavily rate-limited and unsuitable for launch.
# When set, `npm run auth:email` forwards them to the project.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=The Bureaucracy
