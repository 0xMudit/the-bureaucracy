# Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key. Safe in the browser; enforces row-level security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: newer publishable key. Used when the anon key is absent.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key. Never expose this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: comma-separated emails that always resolve to the admin role.
# The deployment editor's address is included automatically. These addresses
# cannot be demoted or suspended from /admin/users; remove one here first.
ADMIN_EMAILS=

# Shared secret for POST /api/ingest (GitHub Actions or manual curl).
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# Canonical site URL used by metadata, sitemap and the RSS feed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Management API token for `npm run auth:email`, which pushes the
# branded confirmation template and requires email confirmation before login.
# Create one at https://supabase.com/dashboard/account/tokens — never expose it
# with NEXT_PUBLIC_.
SUPABASE_ACCESS_TOKEN=

# Optional: custom SMTP for verification mail (Resend, Postmark, SES, ...).
# Supabase's built-in sender is heavily rate-limited and unsuitable for launch.
# When set, `npm run auth:email` forwards them to the project.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=The Bureaucracy
# The DKIM selector printed by your provider (Resend: resend, Postmark: pm).
# `npm run auth:smtp` checks the DNS records for it before you push mail config.
SMTP_DKIM_SELECTOR=

# Peppers the hashed keys used by the shared rate limiter. Changing it only
# resets live counters. Falls back to CRON_SECRET, then a fixed string.
RATE_LIMIT_SALT=

# Optional: Sentry DSN for server and browser error reporting. Leave empty to
# log errors to the platform instead; the app runs fine without it.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only needed to upload source maps during `npm run build` in CI.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional: Resend API key for the 7am email digest. Without it, /api/daily
# reports a dry run instead of failing, and /api/subscribe returns the
# confirmation link directly so local testing works.
RESEND_API_KEY=
# Verified sender for the digest and confirmation mail. The resend.dev sandbox
# address only delivers to the Resend account owner; set a verified domain
# before launch, e.g. "The Bureaucracy <brief@yourdomain.com>".
DIGEST_FROM=

# Optional: Expo access token for push delivery. Public Expo projects do not
# need one; set it if "Enhanced Security for Push Notifications" is enabled.
EXPO_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# AI article briefs (Phase 4). One ordered fallback chain; set whichever free
# tiers you have. Without any key, ingestion keeps the classifier excerpt and
# the UI shows a plain summary instead of invented bullets. None of these
# tiers is unlimited; AI_MAX_PER_RUN and AI_DAILY_CAP bound the spend.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
# Briefs generated per ingest run, and the hard daily ceiling for the queue.
AI_MAX_PER_RUN=10
AI_DAILY_CAP=180
# Article images resolved per ingest run (SSRF-guarded, 8s timeout each).
IMAGE_MAX_PER_RUN=24
ENRICH_CONCURRENCY=3
LLM_TIMEOUT_MS=25000

# ---------------------------------------------------------------------------
# In-app payments (Razorpay). The app opens Razorpay's native checkout, then the
# server verifies the signature and asks Razorpay whether the payment captured.
# Create the keys at https://dashboard.razorpay.com → Account & Settings → API
# keys. The webhook secret is set at Settings → Webhooks; point it at
# https://<your-domain>/api/billing/razorpay and enable payment.captured,
# payment.failed and refund.processed. Without all three, the paywall shows
# "payments are being switched on" and nothing is charged.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Web Push (Phase 5). Generate once with `npx web-push generate-vapid-keys`.
# The public key is exposed to the browser; the private key never is.
# Without these, the in-app notification centre still works, but no push.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:editor@the-bureaucracy.vercel.app

