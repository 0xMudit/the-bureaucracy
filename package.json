{
    "name": "the-bureaucracy",
    "version": "1.0.0",
    "private": true,
    "description": "A Hacker News-style, syllabus-aware 24-hour news radar for UPSC and state PSC aspirants.",
    "license": "MIT",
    "homepage": "https://the-bureaucracy.vercel.app",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/0xMudit/the-bureaucracy.git"
    },
    "bugs": {
        "url": "https://github.com/0xMudit/the-bureaucracy/issues"
    },
    "engines": {
        "node": ">=22"
    },
    "keywords": [
        "upsc",
        "current-affairs",
        "news-aggregator",
        "nextjs",
        "supabase",
        "civil-services"
    ],
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "typecheck": "tsc --noEmit",
        "check": "npm run typecheck && npm run build",
        "seed": "tsx scripts/seed.ts",
        "ingest": "tsx scripts/seed.ts",
        "auth:email": "tsx scripts/apply-auth-email.ts",
        "auth:admins": "tsx scripts/sync-admins.ts",
        "auth:doctor": "tsx scripts/auth-doctor.ts",
        "auth:smtp": "tsx scripts/check-mail.ts",
        "db:start": "npx supabase start",
        "db:push": "npx supabase db push",
        "db:reset": "npx supabase db reset",
        "db:snapshot": "tsx scripts/build-schema.ts",
        "lint": "eslint ."
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@hookform/resolvers": "^3.10.0",
        "@sentry/nextjs": "^11.9.0",
        "@shadcn/react": "^0.3.1",
        "@supabase/ssr": "^0.12.7",
        "@supabase/supabase-js": "^2.118.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "cn": "^0.5.0",
        "date-fns": "^4.4.0",
        "embla-carousel-react": "^8.6.0",
        "input-otp": "^1.5.0",
        "lucide-react": "^1.61.0",
        "next": "16.4.3",
        "next-themes": "^0.4.6",
        "radix-ui": "^1.8.1",
        "react": "19.3.1",
        "react-day-picker": "^10.0.2",
        "react-dom": "19.3.1",
        "react-hook-form": "^7.91.0",
        "react-is": "^19.3.1",
        "react-nice-avatar": "^1.5.0",
        "react-resizable-panels": "^2.1.9",
        "recharts": "^3.10.1",
        "shiki": "^4.5.0",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0",
        "vaul": "^1.1.2",
        "web-push": "^3.6.7",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "4.3.3",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/web-push": "^3.6.4",
        "dotenv": "^17.4.2",
        "eslint": "^9.39.5",
        "eslint-config-next": "^16.4.3",
        "tailwindcss": "4.3.3",
        "tsx": "^4.23.15",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.9.3"
    }
}
