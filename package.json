{
  "name": "the-bureaucracy",
  "version": "1.0.0",
  "private": true,
  "description": "A Hacker News-style, syllabus-aware 24-hour news radar for UPSC and state PSC aspirants.",
  "license": "MIT",
  "homepage": "https://the-bureaucracy.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xMudit/the-bureaucracy.git"
  },
  "bugs": {
    "url": "https://github.com/0xMudit/the-bureaucracy/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "upsc",
    "current-affairs",
    "news-aggregator",
    "nextjs",
    "supabase",
    "civil-services"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "seed": "tsx scripts/seed.ts",
    "ingest": "tsx scripts/seed.ts",
    "auth:email": "tsx scripts/apply-auth-email.ts",
    "auth:admins": "tsx scripts/sync-admins.ts",
    "auth:doctor": "tsx scripts/auth-doctor.ts",
    "auth:smtp": "tsx scripts/check-mail.ts",
    "db:start": "npx supabase start",
    "db:push": "npx supabase db push",
    "db:reset": "npx supabase db reset"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^17.4.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
